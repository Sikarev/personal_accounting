# Скопируй в .env и поправь при необходимости
POSTGRES_USER=pa
POSTGRES_PASSWORD=pa_dev_password
POSTGRES_DB=pa
POSTGRES_PORT=5432

# Строка подключения для API и goose
DATABASE_URL=postgres://pa:pa_dev_password@localhost:5432/pa?sslmode=disable

# HTTP-адрес API
API_ADDR=:8080

# Окружение API: development (логи текстом) или production (логи в JSON, cookie с Secure)
APP_ENV=development

# Флаг Secure у cookie сессии. По умолчанию true в production, false в development.
# COOKIE_SECURE=false

# Обратные прокси (CIDR или IP через запятую), которым API верит в X-Forwarded-For.
# Пусто — заголовок игнорируется, клиент — адрес соединения.
# TRUSTED_PROXIES=10.0.0.0/8

# Origin через запятую, с которых разрешены кросс-доменные запросы, меняющие данные.
# Обычно не нужен: в разработке Vite проксирует /api, и origin один.
# CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Сервер Postgres для тестов api/ (go test ./...). На нём тесты создают
# временные БД со случайными именами и удаляют их после себя.
# Указывай служебную БД (как здесь), не боевую.
TEST_DATABASE_URL=postgres://pa:pa_dev_password@localhost:5432/pa?sslmode=disable
